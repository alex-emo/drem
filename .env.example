# ---- DeepSeek 上游配置（只在服务端读取，前端永远拿不到） ----
# 在 https://platform.deepseek.com 申请后填入
# deepseek | qwen
DREAM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
# 上游地址，一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 普通对话模型
DREAM_MODEL=deepseek-chat
# 开启「深度思考」时使用的模型
DREAM_REASONER_MODEL=deepseek-reasoner
# 没有 Key 时，设为 1 可以用本地模拟流验证 UI（不会请求 DeepSeek）
DREAM_MOCK=0
# 本地服务端口
PORT=8787

# Qwen（阿里云百炼 OpenAI 兼容模式）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash
# 可选：多个密钥轮询负载均衡（逗号或换行分隔）；与 QWEN_API_KEY 自动合并去重
QWEN_API_KEYS=

# 管理员用户名（逗号分隔，大小写不敏感）；只有名单内账号可访问 /admin 与 /api/v1/admin/*
DREAM_ADMIN_USERS=Alex
