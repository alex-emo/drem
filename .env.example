# ---- DeepSeek 上游配置（只在服务端读取，前端永远拿不到） ----
# 在 https://platform.deepseek.com 申请后填入
# deepseek | qwen
DREAM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
# 上游地址，一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 普通对话模型
DREAM_MODEL=deepseek-chat
DEEPSEEK_MODEL_CHAT=deepseek-v4-pro
DEEPSEEK_MODEL_FLASH=deepseek-flash
# 开启「深度思考」时使用的模型
DREAM_REASONER_MODEL=deepseek-reasoner
# 没有 Key 时，设为 1 可以用本地模拟流验证 UI（不会请求 DeepSeek）
DREAM_MOCK=0
# 本地服务端口
PORT=8787

# Qwen（阿里云百炼 OpenAI 兼容模式）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash
QWEN_MODEL_PRO=qwen3.7-plus
# 可选：多个密钥轮询负载均衡（逗号或换行分隔）；与 QWEN_API_KEY 自动合并去重
QWEN_API_KEYS=

# 语音识别（可选）：默认复用 QWEN_API_KEY(S)，聊天用 DeepSeek 时也可单独配置。
# 未配置时 /api/v1/tools/asr 返回 0x4006「服务端语音识别未配置」，不会有静默失败。
DREAM_ASR_API_KEY=
DREAM_ASR_API_KEYS=
DREAM_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DREAM_ASR_MODEL=qwen3-asr-flash
DREAM_ASR_TIMEOUT_MS=30000
DREAM_ASR_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
DREAM_ASR_REALTIME_MODEL=paraformer-realtime-v2
# 每个 IP 每分钟语音识别请求数
DREAM_RL_ASR=30

# 管理员用户名（逗号分隔，大小写不敏感）；只有名单内账号可访问 /admin 与 /api/v1/admin/*
DREAM_ADMIN_USERS=Alex

# 内容安全拒绝不做供应商回退：按 DeepSeek 客户端方式返回固定 refusal 答复（见 docs/api.md）。
# 用户模型目录会同时使用 QWEN_* 与 DEEPSEEK_*：默认模型 qwen3.7-flash，可在后台逐用户切换。
