{
  "name": "dream",
  "private": true,
  "version": "0.1.0",
  "description": "Dream - a DeepSeek-like chat client (web first, Android via Capacitor later)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @dream/web",
    "dev:server": "npm run dev --workspace @dream/server",
    "build": "npm run build --workspace @dream/web",
    "build:server": "esbuild apps/server/src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=apps/server/dist/server.mjs --log-level=warning --external:@aws-sdk/client-s3 --banner:js=\"import { createRequire as __dshCreateRequire } from 'node:module'; const require = __dshCreateRequire(import.meta.url);\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm run start --workspace @dream/server",
    "mobile:dev": "npm --workspace @dream/mobile run dev",
    "mobile:build": "npm --workspace @dream/mobile run build",
    "mobile:sync": "npm --workspace @dream/mobile exec cap sync",
    "version:check": "node scripts/check-versions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "vitest run --project server",
    "test:web": "vitest run --project web",
    "test:integration": "vitest run --project server tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc -p tests/tsconfig.json --noEmit"
  },
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "vitest": "^5.1.1"
  },
  "license": "GPL-3.0-only"
}
