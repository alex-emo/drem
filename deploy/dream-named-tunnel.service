[Unit]
Description=Cloudflare named tunnel "dream" for Dream (token file)
After=network-online.target
Wants=network-online.target

[Service]
TimeoutStartSec=15
Type=notify
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --token-file /etc/cloudflared/dream-token
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
